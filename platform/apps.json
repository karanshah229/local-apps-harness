{
  "$schema": "./apps.schema.json",
  "version": 1,
  "defaults": {
    "access": "local-network",
    "webStack": "react-vite-tailwind-shadcn",
    "apiStack": "fastify-prisma-postgresql",
    "mobileStack": "expo-react-native-nativewind"
  },
  "apps": [
    {
      "id": "microsoft-todo",
      "displayName": "Microsoft To Do Clone",
      "recipe": "legacy-react-express-sqlite",
      "status": "legacy",
      "capabilities": ["tasks", "realtime-sync", "whatsapp-reminders"],
      "paths": {
        "web": "apps/microsoft-todo-client",
        "api": "apps/microsoft-todo-server"
      },
      "web": { "basePath": "/todo" },
      "api": { "internalPort": 5005, "healthPath": "/healthz" },
      "data": { "engine": "sqlite", "database": "todo.db", "migrationState": "legacy" },
      "docker": { "service": "todo", "containerName": "todo-app", "dockerfile": "apps/microsoft-todo-server/Dockerfile", "volumes": ["todo-data"] },
      "nginx": { "route": "/todo/", "upstream": "todo:5005" },
      "backup": { "strategy": "filesystem", "container": "todo-app", "containerPath": "/app/data", "localPaths": ["apps/microsoft-todo-server/todo.db"] },
      "mobile": null
    },
    {
      "id": "stock-manager",
      "displayName": "Stock Manager",
      "recipe": "legacy-react-express-sqlite",
      "status": "legacy",
      "capabilities": ["stock-management", "photo-uploads", "reports"],
      "paths": {
        "web": "apps/stock-manager-client",
        "api": "apps/stock-manager-server"
      },
      "web": { "basePath": "/stock" },
      "api": { "internalPort": 5001, "healthPath": "/healthz" },
      "data": { "engine": "sqlite", "database": "stock.db", "migrationState": "legacy" },
      "docker": { "service": "stock", "containerName": "stock-app", "dockerfile": "apps/stock-manager-server/Dockerfile", "volumes": ["stock-data"] },
      "nginx": { "route": "/stock/", "upstream": "stock:5001" },
      "backup": {
        "strategy": "filesystem",
        "container": "stock-app",
        "containerPath": "/app/data",
        "legacyContainerPaths": ["/app/server/stock.db", "/app/server/uploads"],
        "localPaths": ["apps/stock-manager-server/stock.db", "apps/stock-manager-server/uploads"]
      },
      "mobile": null
    },
    {
      "id": "sip-of-gold",
      "displayName": "Sip of Gold",
      "recipe": "legacy-static-vite",
      "status": "legacy",
      "capabilities": ["static-web-experience"],
      "paths": { "web": "apps/sip-of-gold", "api": null },
      "web": { "basePath": "/gold", "healthPath": "/" },
      "api": null,
      "data": null,
      "docker": { "service": "gold", "containerName": "gold-app", "dockerfile": "apps/sip-of-gold/Dockerfile", "volumes": [] },
      "nginx": { "route": "/gold/", "upstream": "gold:80" },
      "backup": null,
      "mobile": null
    }
  ]
}
