{
  "id": "react-native-expo",
  "purpose": "Preferred stack for mobile development (Android & iOS) when all features can be built without writing native code",
  "stack": ["react-native", "expo", "typescript", "nativewind"],
  "platforms": {
    "android": ["package", "permissions", "versionCode", "apk"],
    "ios": ["bundleIdentifier", "entitlements", "buildNumber", "simulator", "signedIpa", "testflight-after-approval"]
  },
  "requiredConnections": ["workspace", "apiEnvironment", "appConfig", "buildProfiles", "deviceTests", "artifacts", "registry"],
  "forbiddenDefaults": ["authentication", "push-notifications", "deep-links", "background-location", "analytics"]
}
