{
  "expo": {
    "name": "Kamdhenu ToDo",
    "slug": "microsoft-todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kamdhenu.microsofttodo",
      "infoPlist": {
        "NSContactsUsageDescription": "Kamdhenu ToDo needs access to your contacts to let you assign tasks and share lists with teammates and contacts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0078d4"
      },
      "package": "com.kamdhenu.microsofttodo",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "READ_CONTACTS",
        "WRITE_CONTACTS"
      ]
    },
    "scheme": "microsoft-todo",
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Kamdhenu ToDo to access your contacts to easily assign tasks and share lists."
        }
      ],
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0078d4"
        }
      ]
    ]
  }
}
