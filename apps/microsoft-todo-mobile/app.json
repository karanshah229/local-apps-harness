{
  "expo": {
    "name": "Microsoft To Do",
    "slug": "microsoft-todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0078d4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saileshbhai.microsofttodo",
      "infoPlist": {
        "NSContactsUsageDescription": "Microsoft To Do needs access to your contacts to let you assign tasks and share lists with teammates and contacts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0078d4"
      },
      "package": "com.saileshbhai.microsofttodo",
      "permissions": [
        "READ_CONTACTS",
        "WRITE_CONTACTS"
      ]
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Microsoft To Do to access your contacts to easily assign tasks and share lists."
        }
      ]
    ]
  }
}
